{
  "name": "dsh-connect-deveco",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH bundle plugin: manage the local opencode-deveco proxy that brings DevEco Code (Huawei GLM) into DeepSeek Harness — status chip, start/stop/restart, Huawei OAuth login/logout, and a watchdog.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deveco",
    "huawei",
    "glm",
    "llm-provider"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "stop-proxy-wmi.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "config/**",
    "scripts/**",
    "vendor/opencode-deveco/**",
    "dev/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
